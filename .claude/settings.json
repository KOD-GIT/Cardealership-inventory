{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(python -m ruff check *)",
      "Bash(python3 -m ruff check *)",
      "Bash(python -m app.scripts.doctor)",
      "Bash(python3 -m app.scripts.doctor)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run build *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)"
